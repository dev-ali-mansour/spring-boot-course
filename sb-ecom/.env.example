# .env.example
# Copy this file to .env and adjust the values for your local environment.
# Do NOT commit .env with real credentials to GitHub.

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/studentsdb
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# JPA / Hibernate
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

JWT_SECRET_BASE64=your_secret_key_here

#URLS
FRONTEND_URL=http://localhost:3000
IMAGE_BASE_URL=http://localhost:8080/images

# Host Volume Mounts (Optional - defaults to ./images and ./logs)
HOST_IMAGES_DIR=./images
HOST_LOGS_DIR=./logs
